.container {
  padding: 30rpx;
  min-height: 100vh;
  background-color: #f8fafc;
  display: block;
  align-items: initial;
  padding-bottom: 140rpx;
}

.title {
  font-size: 42rpx;
  font-weight: bold;
  color: #1a73e8;
  text-align: center;
  margin: 40rpx 0 50rpx;
}

/* 分组卡片 */
.group-card {
  background: white;
  border-radius: 18rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.15s ease;
}

.group-card:active {
  transform: scale(0.98);
  background-color: #f0f7ff;
}

.group-title {
  font-size: 36rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.group-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.group-count {
  font-size: 26rpx;
  color: #1a73e8;
  font-weight: 500;
}

.card-arrow {
  font-size: 36rpx;
  color: #ccc;
}

/* 空状态 */
.empty {
  text-align: center;
  margin-top: 200rpx;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
  opacity: 0.7;
}

.empty-text {
  font-size: 36rpx;
  color: #666;
  display: block;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.empty-tip {
  font-size: 26rpx;
  color: #999;
  display: block;
}

/* 返回按钮 */
.back-btn {
  width: 100%;
  background: linear-gradient(135deg, #f1f8ff 0%, #e3f2fd 100%);
  color: #1a73e8;
  border: 2rpx solid #1a73e8;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 32rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(26, 115, 232, 0.15);
  position: fixed;
  bottom: 40rpx;
  left: 30rpx;
  right: 30rpx;
  z-index: 20;
}

.back-btn:active {
  background: #bbdefb;
  transform: scale(0.98);
}
