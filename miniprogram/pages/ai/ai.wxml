<view class="container">
  <!-- 顶部蓝色区域（覆盖到最顶） -->
  <view style="background:#1a73e8; width:100%; flex-shrink:0;">
    <!-- 状态栏 -->
    <view style="height:{{statusBarHeight}}px;"></view>
    <!-- 头部 -->
    <view class="header">
      <view class="header-left" bindtap="goBack">
        <text class="back-arrow">‹</text>
        <text class="back-text">返回</text>
      </view>
      <text class="header-title">AI 知识库</text>
      <view class="header-right" bindtap="clearChat">
        <text class="clear-btn">清空</text>
      </view>
    </view>
  </view>

  <!-- 消息列表 -->
  <scroll-view class="chat-scroll" scroll-y scroll-into-view="msg-bottom" scroll-with-animation>
    <view class="messages">
      <view class="message-item {{item.role === 'user' ? 'msg-user' : 'msg-assistant'}}" wx:for="{{messages}}" wx:key="index" wx:for-index="msgIdx">

        <!-- 用户消息 -->
        <view wx:if="{{item.role === 'user'}}" class="bubble bubble-user">
          <text class="bubble-text" selectable="{{true}}">{{item.content}}</text>
        </view>

        <!-- AI 回答 -->
        <view wx:else class="bubble bubble-assistant {{item.isError ? 'bubble-error' : ''}}">
          <!-- 分段渲染（文字 + 可点击引用 [N]） -->
          <block wx:if="{{item.segments}}">
            <text class="bubble-text" selectable="{{true}}">
              <block wx:for="{{item.segments}}" wx:key="index">
                <text wx:if="{{item.t === 'cite'}}" class="cite-num" data-idx="{{item.v}}" data-msg-index="{{msgIdx}}" bindtap="onCiteTap">[{{item.v}}]</text>
                <text wx:else>{{item.v}}</text>
              </block>
            </text>
          </block>
          <text wx:else class="bubble-text" selectable="{{true}}">{{item.content}}</text>

          <!-- 参考文档列表 -->
          <view wx:if="{{item.sources && item.sources.length > 0}}" class="source-section" id="source-{{msgIdx}}">
            <view class="source-divider"></view>
            <view class="source-title">参考文档</view>
            <view wx:for="{{item.sources}}" wx:key="index" class="source-item" bindtap="openSource" data-fileid="{{item.fileId}}" data-name="{{item.name}}">
              <text class="source-badge">{{index + 1}}</text>
              <text class="source-name" data-fileid="{{item.fileId}}">{{item.name}}</text>
            </view>
          </view>
        </view>

      </view>

      <!-- 加载中 -->
      <view class="message-item msg-assistant" wx:if="{{isLoading}}">
        <view class="bubble bubble-assistant">
          <view class="loading-dots">
            <text class="dot">.</text>
            <text class="dot">.</text>
            <text class="dot">.</text>
          </view>
        </view>
      </view>

      <view id="msg-bottom"></view>
    </view>
  </scroll-view>

  <!-- 底部输入区 -->
  <view class="input-area">
    <input class="input-box" placeholder="输入你的问题..." value="{{inputValue}}" bindinput="onInput" bindconfirm="sendMessage" confirm-type="send" disabled="{{isLoading}}" />
    <button class="send-btn {{canSend ? '' : 'send-disabled'}}" bindtap="sendMessage" disabled="{{!canSend || isLoading}}">发送</button>
  </view>
</view>
