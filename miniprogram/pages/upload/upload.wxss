/* pages/upload/upload.wxss - 纯净无字体版 */

.upload-container {
  padding: 30rpx;
  background-color: #f8f9fa;
  min-height: 100vh;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 40rpx;
}

.category-section {
  margin-bottom: 40rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.picker-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background-color: white;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
  border: 1rpx solid #eaeaea;
}

.picker-text {
  font-size: 30rpx;
  color: #333;
}

.arrow {
  font-size: 24rpx;
  color: #999;
}

/* 按钮组 */
.button-group {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}

/* 按钮通用样式 */
.choose-file-btn,
.choose-image-btn,
.btn-multiple,
.upload-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 26rpx;
  border-radius: 16rpx;
  border: none;
  font-size: 28rpx;
  color: white;
  box-sizing: border-box;
}

.btn-icon {
  font-size: 38rpx;
  margin-right: 10rpx;
  line-height: 1;
}

/* 按钮配色 */
.choose-file-btn { 
  flex: 1; 
  min-width: 200rpx; 
  background-color: #4CAF50; 
}
.choose-image-btn { 
  flex: 1; 
  min-width: 200rpx; 
  background-color: #fc8021; 
}
.btn-multiple { 
  width: 100%; 
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); 
  margin-bottom: 24rpx; 
}
.upload-btn { 
  width: 100%; 
  background: linear-gradient(135deg, #00c853 0%, #00e676 100%); 
  box-shadow: 0 4rpx 12rpx rgba(0, 200, 83, 0.3); 
}
.upload-btn[disabled] {
  background: #ccc;
  color: #999;
  box-shadow: none;
}

/* 🔑 文件预览区（核心修复） */
.file-preview {
  background-color: white;
  border-radius: 16rpx;
  padding: 25rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
  margin-bottom: 30rpx;
}

.preview-header {
  font-size: 28rpx;
  font-weight: bold;
  color: #1a73e8;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 2rpx solid #f0f5ff;
}

.file-list {
  max-height: 400rpx;
  overflow-y: auto;
}

.file-item {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.file-item:last-child {
  border-bottom: none;
}

.file-name {
  font-size: 26rpx;
  color: #333;
  max-width: 75%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-size {
  font-size: 24rpx;
  color: #888;
  flex-shrink: 0;
  margin-left: 15rpx;
}

.single-file-info {
  padding: 15rpx 0;
}