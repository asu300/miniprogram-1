.container {
  padding: 24rpx 0;
  background-color: #f8fafc;
  min-height: 100vh;
  display: block;
  align-items: initial;
}

.title {
  font-size: 42rpx;
  font-weight: bold;
  color: #1a73e8;
  text-align: center;
  margin: 36rpx 0 24rpx;
  padding: 0 30rpx;
}

/* ========== scroll-view 横向翻页 ========== */
.category-scroll {
  width: 100vw;
  white-space: nowrap;
}

.scroll-track {
  display: inline-flex;
}

.scroll-page {
  width: 100vw;
  padding: 0 30rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

/* ========== 页码指示器 ========== */
.page-dots {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
  margin: 16rpx 0 28rpx;
}

.page-dots .dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #d0d0d0;
  transition: all 0.3s ease;
}

.page-dots .dot.active {
  background: #1a73e8;
  width: 32rpx;
  border-radius: 8rpx;
}

/* ========== 搜索栏 ========== */
.search-bar {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  gap: 16rpx;
  padding: 0 30rpx;
}

.search-input {
  flex: 3;
  height: 80rpx;
  background: white;
  border-radius: 18rpx;
  padding: 0 28rpx;
  font-size: 32rpx;
  color: #333;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
  border: 2rpx solid transparent;
}

.search-btn {
  flex: 2;
  height: 80rpx;
  padding: 0 16rpx;
  background: linear-gradient(135deg, #e8c800, #d4a900);
  color: white;
  border: none;
  border-radius: 18rpx;
  font-size: 34rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-btn:active {
  transform: scale(0.97);
}

.search-clear-btn {
  height: 80rpx;
  min-width: 100rpx;
  background: #f1f3f5;
  color: #666;
  border: none;
  border-radius: 18rpx;
  font-size: 28rpx;
  padding: 0 20rpx;
  line-height: 80rpx;
}

/* ========== 搜索结果列表 ========== */
.results-header {
  margin-bottom: 16rpx;
  padding: 0 30rpx;
}

.results-title {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.result-item {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx 22rpx;
  margin: 0 30rpx 16rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.15s ease;
}

.result-item:active {
  transform: scale(0.98);
  background-color: #f0f7ff;
  box-shadow: 0 8rpx 20rpx rgba(26, 115, 232, 0.2);
}

.result-row {
  display: flex;
  align-items: center;
}

.result-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  min-width: 36rpx;
  text-align: center;
}

.result-info {
  flex: 1;
  min-width: 0;
}

.result-name {
  font-size: 32rpx;
  color: #1a73e8;
  font-weight: 500;
  display: block;
  word-break: break-all;
  line-height: 1.5;
}

.result-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
}

.result-category {
  font-size: 24rpx;
  color: white;
  background: #1a73e8;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  line-height: 1.6;
}

.result-time {
  font-size: 24rpx;
  color: #999;
}

.result-arrow {
  font-size: 40rpx;
  color: #ccc;
  margin-left: 12rpx;
  font-weight: 300;
}

/* ========== 搜索空状态 ========== */
.search-empty {
  text-align: center;
  margin-top: 80rpx;
  margin-bottom: 60rpx;
  padding: 0 30rpx;
}

.search-empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
  opacity: 0.7;
}

.search-empty-text {
  font-size: 34rpx;
  color: #666;
  display: block;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.search-empty-tip {
  font-size: 26rpx;
  color: #999;
  display: block;
}

/* ========== 分类网格 ========== */
.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 28rpx;
  padding: 10rpx 0;
}

.category-card {
  width: calc(50% - 14rpx);
  background: #ffffff;
  border-radius: 18rpx;
  padding: 40rpx 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  border: 2rpx solid #e8edf2;
  transition: all 0.15s ease;
  box-sizing: border-box;
}

.category-card:active {
  transform: scale(0.97);
  background-color: #f0f7ff;
  box-shadow: 0 8rpx 20rpx rgba(26, 115, 232, 0.2);
}

.icon {
  font-size: 40rpx;
  margin-bottom: 14rpx;
  color: #1a73e8;
}

.label {
  font-size: 36rpx;
  font-weight: 600;
  color: #222;
  text-align: center;
  line-height: 1.4;
}

/* ========== AI 悬浮球 ========== */
.ai-float {
  position: fixed;
  right: 0;
  top: 68%;
  width: 24rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #1a73e8, #0d47a1);
  border-radius: 24rpx 0 0 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  z-index: 999;
  box-shadow: -4rpx 0 12rpx rgba(26, 115, 232, 0.3);
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  overflow: hidden;
}

.ai-float.expanded {
  width: 140rpx;
  box-shadow: -8rpx 4rpx 24rpx rgba(26, 115, 232, 0.45);
}

.ai-float-icon {
  font-size: 44rpx;
  opacity: 0;
  transition: opacity 0.2s ease;
}

.ai-float-label {
  font-size: 22rpx;
  color: white;
  font-weight: bold;
  text-align: center;
  line-height: 1.3;
  opacity: 0;
  transition: opacity 0.2s ease;
}

.ai-float.expanded .ai-float-icon,
.ai-float.expanded .ai-float-label {
  opacity: 1;
}

/* 上传按钮 */
.upload-btn {
  width: calc(100% - 60rpx);
  margin: 0 30rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #1a73e8, #0d47a1);
  color: white;
  border: none;
  border-radius: 18rpx;
  font-size: 34rpx;
  font-weight: bold;
  box-shadow: 0 10rpx 24rpx rgba(26, 115, 232, 0.35);
}
