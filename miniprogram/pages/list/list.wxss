/* pages/list/list.wxss */

.container {
  padding: 30rpx;
  min-height: 100vh;
  background-color: #f9fbfd;
  position: relative;
}

.header {
  font-size: 44rpx;
  font-weight: bold;
  color: #1a73e8;
  text-align: center;
  margin-bottom: 40rpx;
  padding: 20rpx;
  border-bottom: 2rpx solid #e0e0e0;
  position: relative;
  z-index: 10;
}

/* ========== 文件列表 ========== */
.file-list {
  margin-bottom: 60rpx;
}

.file-item {
  background: white;
  padding: 32rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  position: relative;
  transition: transform 0.2s;
}

.file-item:active {
  transform: scale(0.98);
}

/* 高亮动画（从搜索结果跳转时） */
.file-highlighted {
  background: #e8f4ff !important;
  box-shadow: 0 4rpx 20rpx rgba(26, 115, 232, 0.3) !important;
  border: 2rpx solid #1a73e8;
  animation: highlightPulse 0.6s ease-in-out 3;
}

@keyframes highlightPulse {
  0%, 100% { background: #e8f4ff; }
  50% { background: #cce5ff; }
}

/* 🔑 置顶标识（右上角悬浮） */
.top-badge {
  position: absolute;
  top: 16rpx;
  right: 20rpx;
  background: linear-gradient(135deg, #ff6b6b, #ee5a24);
  color: white;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  font-weight: bold;
  z-index: 10;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.15);
  line-height: 1.4;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0% { box-shadow: 0 0 0 0 rgba(238, 90, 36, 0.4); }
  70% { box-shadow: 0 0 0 8rpx rgba(238, 90, 36, 0); }
  100% { box-shadow: 0 0 0 0 rgba(238, 90, 36, 0); }
}

/* 🔑 置顶文件名避让（防止与标签重叠） */
.name-top {
  padding-right: 80rpx !important;
}

/* ========== 文件信息 ========== */
/* 🔥 新增：文件行容器（图标 + 文件名） */
.file-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

/* 🔥 新增：文件类型图标 */
.file-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
  min-width: 36rpx;
  text-align: center;
  line-height: 1;
}

.file-name {
  font-size: 34rpx;
  color: #1a73e8;
  display: block;
  word-break: break-all;
  line-height: 1.5;
  font-weight: 500;
}

.file-time {
  font-size: 26rpx;
  color: #888;
  display: block;
  margin-bottom: 12rpx;
}

/* ========== PPT提示 ========== */
.ppt-hint {
  font-size: 24rpx;
  color: #e67e22;
  background: #fff8e6;
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
  display: inline-block;
  margin-top: 8rpx;
  border-left: 3rpx solid #f39c12;
}

/* ========== 管理员操作区 ========== */
.admin-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}

/* 🔑 置顶按钮（核心新增） */
.btn-top {
  flex: 1;
  min-width: 110rpx;
  font-size: 24rpx;
  padding: 8rpx 0;
  border-radius: 8rpx;
  border: none;
  font-weight: 500;
  transition: all 0.2s;
}

.btn-top:not(.active) {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  color: white;
  box-shadow: 0 2rpx 6rpx rgba(79, 172, 254, 0.3);
}

.btn-top.active {
  background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
  color: #c0392b;
  font-weight: bold;
  box-shadow: 0 2rpx 6rpx rgba(255, 154, 158, 0.3);
}

.btn-top:active {
  transform: scale(0.95);
}

/* 原有按钮优化（适配三按钮布局） */
.btn-edit, 
.btn-delete {
  flex: 1;
  min-width: 110rpx;
  font-size: 24rpx;
  padding: 8rpx 0;
  border-radius: 8rpx;
  border: none;
  font-weight: 500;
}

.btn-edit {
  background-color: #e3f2fd;
  color: #1976d2;
  border: 1rpx solid #90caf9;
}

.btn-edit:active {
  background-color: #bbdefb;
}

.btn-delete {
  background-color: #ffebee;
  color: #c62828;
  border: 1rpx solid #ef9a9a;
}

.btn-delete:active {
  background-color: #ffcdd2;
}

/* ========== 空状态优化 ========== */
.empty {
  text-align: center;
  margin-top: 150rpx;
  color: #999;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
  opacity: 0.7;
}

.empty-text {
  font-size: 36rpx;
  display: block;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.empty-tip {
  display: block;
  margin-top: 20rpx;
  color: #1a73e8;
  font-size: 26rpx;
  background: #e8f4ff;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  inline-size: fit-content;
  margin-left: auto;
  margin-right: auto;
}

/* ========== 返回按钮 ========== */
.back-btn {
  width: 100%;
  background: linear-gradient(135deg, #f1f8ff 0%, #e3f2fd 100%);
  color: #1a73e8;
  border: 2rpx solid #1a73e8;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 32rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(26, 115, 232, 0.15);
  position: fixed;
  bottom: 40rpx;
  left: 30rpx;
  right: 30rpx;
  z-index: 20;
}

.back-btn:active {
  background: #bbdefb;
  transform: scale(0.98);
}

/* ========== 响应式优化 ========== */
@media (max-width: 375px) {
  .admin-actions {
    flex-direction: column;
    gap: 10rpx;
  }
  .btn-top, .btn-edit, .btn-delete {
    width: 100%;
    min-width: auto;
  }
}